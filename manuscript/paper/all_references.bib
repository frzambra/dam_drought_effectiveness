@article{Prigent2010,
	title = {Precipitation retrieval from space: {An} overview},
	volume = {342},
	issn = {1631-0713},
	url = {https://www.sciencedirect.com/science/article/pii/S1631071310000155},
	doi = {10.1016/J.CRTE.2010.01.004},
	abstract = {During the last decade, satellite observations have allowed significant advances in quantifying precipitation, especially with the contribution of the TRMM mission. Observations at different wavelengths (visible, infrared, and microwaves), in both active and passive microwave modes, are analyzed, and eventually coupled to produce records of precipitation estimates over the globe, with up to hourly time sampling. This article provides an overview of the techniques, the results and the perspectives. Au cours de la dernière décennie, les observations par satellites ont permis des progrès significatifs dans la quantification des précipitations, en particulier avec la contribution de la mission TRMM. Les observations à différentes longueurs d’onde (visible, infrarouge et micro-ondes), à la fois en modes actifs et passifs pour les micro-ondes, sont analysées et éventuellement couplées pour fournir des estimations des précipitations pour tout le globe, avec une répétitivité jusqu’à l’heure. Ce papier rappelle les techniques utilisées, résume les résultats obtenus et présente les perspectives dans ce domaine.},
	number = {4-5},
	urldate = {2019-04-27},
	journal = {Comptes Rendus Geoscience},
	author = {Prigent, Catherine},
	month = apr,
	year = {2010},
	note = {Publisher: Elsevier Masson},
	pages = {380--389},
	file = {PDF:/home/francisco/Zotero/storage/49AGNENC/full-text.pdf:application/pdf},
}

@article{zhong_deep_2019,
	title = {Deep learning based multi-temporal crop classification},
	volume = {221},
	issn = {0034-4257},
	url = {https://www.sciencedirect.com/science/article/pii/S0034425718305418},
	doi = {10.1016/J.RSE.2018.11.032},
	abstract = {This study aims to develop a deep learning based classification framework for remotely sensed time series. The experiment was carried out in Yolo County, California, which has a very diverse irrigated agricultural system dominated by economic crops. For the challenging task of classifying summer crops using Landsat Enhanced Vegetation Index (EVI) time series, two types of deep learning models were designed: one is based on Long Short-Term Memory (LSTM), and the other is based on one-dimensional convolutional (Conv1D) layers. Three widely-used classifiers were also tested for comparison, including a gradient boosting machine called XGBoost, Random Forest, and Support Vector Machine. Although LSTM is widely used for sequential data representation, in this study its accuracy (82.41\%) and F1 score (0.67) were the lowest among all the classifiers. Among non-deep-learning classifiers, XGBoost achieved the best result with 84.17\% accuracy and an F1 score of 0.69. The highest accuracy (85.54\%) and F1 score (0.73) were achieved by the Conv1D-based model, which mainly consists of a stack of Conv1D layers and an inception module. The behavior of the Conv1D-based model was inspected by visualizing the activation on different layers. The model employs EVI time series by examining shapes at various scales in a hierarchical manner. Lower Conv1D layers of the optimized model capture small scale temporal variations, while upper layers focus on overall seasonal patterns. Conv1D layers were used as an embedded multi-level feature extractor in the classification model which automatically extracts features from input time series during training. The automated feature extraction reduces the dependency on manual feature engineering and pre-defined equations of crop growing cycles. This study shows that the Conv1D-based deep learning framework provides an effective and efficient method of time series representation in multi-temporal classification tasks.},
	urldate = {2019-04-27},
	journal = {Remote Sensing of Environment},
	author = {Zhong, Liheng and Hu, Lina and Zhou, Hang},
	month = feb,
	year = {2019},
	note = {Publisher: Elsevier},
	pages = {430--443},
	file = {PDF:/home/francisco/Zotero/storage/Q72R362Z/full-text.pdf:application/pdf},
}

