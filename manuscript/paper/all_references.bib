@article{Mishra2010,
	title = {A review of drought concepts},
	volume = {391},
	issn = {0022-1694},
	url = {http://www.sciencedirect.com/science/article/pii/S0022169410004257},
	doi = {http://dx.doi.org/10.1016/j.jhydrol.2010.07.012},
	abstract = {Summary Owing to the rise in water demand and looming climate change, recent years have witnessed much focus on global drought scenarios. As a natural hazard, drought is best characterized by multiple climatological and hydrological parameters. An understanding of the relationships between these two sets of parameters is necessary to develop measures for mitigating the impacts of droughts. Beginning with a discussion of drought definitions, this paper attempts to provide a review of fundamental concepts of drought, classification of droughts, drought indices, historical droughts using paleoclimatic studies, and the relation between droughts and large scale climate indices. Conclusions are drawn where gaps exist and more research needs to be focussed.},
	number = {1–2},
	journal = {J. Hydrol.},
	author = {Mishra, Ashok K and Singh, Vijay P},
	year = {2010},
	keywords = {Drought indices, Definitions, Groundwater droughts, Large scale climate indices, Paleoclimatic study for droughts},
