@article{pan_mapping_2015,
	title = {Mapping crop phenology using {NDVI} time-series derived from {HJ}-1 {A}/{B} data},
	volume = {34},
	issn = {0303-2434},
	url = {https://www.sciencedirect.com/science/article/pii/S0303243414001755},
	doi = {10.1016/J.JAG.2014.08.011},
	abstract = {With the availability of high frequent satellite data, crop phenology could be accurately mapped using time-series remote sensing data. Vegetation index time-series data derived from AVHRR, MODIS, and SPOT-VEGETATION images usually have coarse spatial resolution. Mapping crop phenology parameters using higher spatial resolution images (e.g., Landsat TM-like) is unprecedented. Recently launched HJ-1 A/B CCD sensors boarded on China Environment Satellite provided a feasible and ideal data source for the construction of high spatio-temporal resolution vegetation index time-series. This paper presented a comprehensive method to construct NDVI time-series dataset derived from HJ-1 A/B CCD and demonstrated its application in cropland areas. The procedures of time-series data construction included image preprocessing, signal filtering, and interpolation for daily NDVI images then the NDVI time-series could present a smooth and complete phenological cycle. To demonstrate its application, TIMESAT program was employed to extract phenology parameters of crop lands located in Guanzhong Plain, China. The small-scale test showed that the crop season start/end derived from HJ-1 A/B NDVI time-series was comparable with local agro-metrological observation. The methodology for reconstructing time-series remote sensing data had been proved feasible, though forgoing researches will improve this a lot in mapping crop phenology. Last but not least, further studies should be focused on field-data collection, smoothing method and phenology definitions using time-series remote sensing data.},
	urldate = {2019-08-02},
	journal = {International Journal of Applied Earth Observation and Geoinformation},
	author = {Pan, Zhuokun and Huang, Jingfeng and Zhou, Qingbo and Wang, Limin and Cheng, Yongxiang and Zhang, Hankui and Blackburn, George Alan and Yan, Jing and Liu, Jianhong},
	month = feb,
	year = {2015},
	note = {Publisher: Elsevier},
	pages = {188--197},
	file = {PDF:/home/francisco/Zotero/storage/Z28FD9X4/full-text.pdf:application/pdf;PDF:/home/francisco/Zotero/storage/E3M4SW4E/full-text.pdf:application/pdf},
}

@article{schnelle_internationale_1964,
	title = {Internationale phänologische gärten {Stationen} eines grundnetzes für internationale phänologische beobachtungen},
	volume = {1},
	issn = {0002-1571},
	url = {https://www.sciencedirect.com/science/article/pii/0002157164900056},
	doi = {10.1016/0002-1571(64)90005-6},
	abstract = {Altogether 44 International Phenological Gardens, which are to serve as stations of a basic network of large-scale phenological observations, were established in Europe on a cross-section from north to south, from Scandinavia to Greece. In these gardens conifers, deciduous trees and shrubs were planted and derived asexually (by means of layers). Phenological observations are conducted on these plants according to a uniform programme. Their hereditary characteristics being identical, the differences which occur in the beginning of the phenological phases are caused only by exterior, especially climatic influences. In the proximity of each of these gardens are climatological stations the observational data of which are required for evaluating the phenological phenomena. The network of these International Phenological Gardens is now being extended to other countries further east and west of the above mentioned line. Als Stationen eines Grundnetzes für grossräumige phänologische Beobachtungen wurden 44 Internationale Phänologische Gärten auf einem Nord-Süd Schnitt durch Europa von Skandinavien bis Griechenland eigerichtet. In diesen Gärten wurden Nadelbäume, Laubbäume und Sträucher angepflanzt, die vegetativ (durch Stecklinge) vermehrt wurden und an denen nach einheitlichem Programm phänologische Beobachtungen durchgeführt werden. Infolge der gleichen Erbanlagen sind die auftretenden Unterschiede im Beginn der phänologischen Wachstumsphasen nur durch die äusseren, besonders klimatischen Einflüsse verursacht. In der Nähe eines jeden Gartens befindet sich eine Klimastation, deren Messwerte bei der Auswertung der Beobachtungen aus den Gärten benötigt werden. Das Netz dieser Internationalen Phänologischen Gärten wird jetzt nach Westen und Osten auch auf andere Länder ausgedehnt.},
	number = {1},
	urldate = {2019-08-02},
	journal = {Agricultural Meteorology},
	author = {Schnelle, F. and Volkert, E.},
	month = mar,
	year = {1964},
	note = {Publisher: Elsevier},
	pages = {22--29},
	file = {PDF:/home/francisco/Zotero/storage/XJQNBA9A/full-text.pdf:application/pdf},
}

