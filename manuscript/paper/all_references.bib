@article{pequeno_production_2024,
	title = {Production vulnerability to wheat blast disease under climate change},
	volume = {14},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1758-678X, 1758-6798},
	url = {https://www.nature.com/articles/s41558-023-01902-2},
	doi = {10.1038/s41558-023-01902-2},
	abstract = {AbstractWheat blast is a devastating disease caused by the fungal pathogen Magnaporthe oryzae pathotype Triticum that has spread to both neighbouring and distant countries following its emergence in Brazil in the 1980s. Under climate change conditions, wheat blast is predicted to spread primarily in tropical regions. Here we coupled a wheat crop simulation model with a newly developed wheat blast model, to provide quantitative global estimates of wheat blast vulnerability under current and future climates. Under current climatic conditions, 6.4 million hectares of arable land is potentially vulnerable to wheat blast. A more humid and warmer climate in the future (Representative Concentration Pathway 8.5) is likely to increase the area suitable for wheat blast infection, particularly in the Southern Hemisphere, and reduce global wheat production by 69 million tons per year (13\% decrease) by mid-century. Impacts of climate change could be further exacerbated and food security problems increased.},
	language = {en},
	number = {2},
	urldate = {2025-07-18},
	journal = {Nature Climate Change},
	author = {Pequeno, Diego N. L. and Ferreira, Thiago B. and Fernandes, José M. C. and Singh, Pawan K. and Pavan, Willingthon and Sonder, Kai and Robertson, Richard and Krupnik, Timothy J. and Erenstein, Olaf and Asseng, Senthold},
	month = feb,
	year = {2024},
	note = {Publisher: Springer Science and Business Media LLC},
	pages = {178--183},
