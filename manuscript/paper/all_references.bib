@article{Seiler1998,
	title = {{AVHRR}-based vegetation and temperature condition indices for drought detection in {Argentina}},
	volume = {21},
	issn = {0273-1177},
	url = {http://www.sciencedirect.com/science/article/pii/S0273117797008843},
