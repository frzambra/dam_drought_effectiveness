	journal = {Monthly Weather Review},
	author = {Griffith, Cecilia Girz and Woodley, William Lee and Grube, Pamela G. and Martin, David W. and Stout, John and Sikdar, Dhirendra N. and Griffith, Cecilia Girz and Woodley, William Lee and Grube, Pamela G. and Martin, David W. and Stout, John and Sikdar, Dhirendra N.},
	month = aug,
