@article{burkhalter_estimating_2013,
	title = {Estimating {Crop} {Water} {Use} via {Remote} {Sensing} {Techniques} \textit{vs} . {Conventional} {Methods} in the {South} {Platte} {River} {Basin}, {Colorado}},
	volume = {49},
